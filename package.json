{
  "name": "hakapit.online",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server/dev.ts",
    "build": "vite build && vite build --ssr src/server/app.ts --outDir dist/server",
    "preview": "node --env-file-if-exists=.env dist/server/app.js",
    "test": "bun test",
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "check": "oxfmt --check . && oxlint .",
    "start": "node --env-file-if-exists=.env dist/server/app.js",
    "typecheck": "tsc",
    "sync-feed": "bun scripts/sync-feed.ts"
  },
  "dependencies": {
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/karantina": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.54.0",
    "@tanstack/ai-gemini": "^0.29.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "marked": "^16.3.0",
    "remix": "3.0.0",
    "sanitize-html": "^2.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.1.2",
    "@types/sanitize-html": "^2.16.0",
    "happy-dom": "^20.14.6",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "bun@1.3.14"
}
